# Copy to .env (chmod 600) and fill in. Never commit .env.

# Required
DISCORD_TOKEN=
ANTHROPIC_API_KEY=
# Your own Discord user ID (Developer Mode > right-click yourself > Copy User ID)
OWNER_ID=

# Optional (defaults shown)
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max. Leave empty to send no effort at all (for models without it).
ANTHROPIC_EFFORT=low
# Includes the model's thinking, so keep some room above the reply itself.
ANTHROPIC_MAX_TOKENS=2048
# Seconds per attempt, and how many times the SDK retries a failed attempt.
ANTHROPIC_TIMEOUT=30
ANTHROPIC_MAX_RETRIES=1
# Past exchanges (message + my reply) from the same channel to include in the prompt.
HISTORY_LIMIT=6
MEMORY_DIR=memory
# Total characters of memory files allowed into one prompt.
MEMORY_MAX_CHARS=24000
DB_PATH=data/assisted_reply.sqlite3
LOG_LEVEL=INFO
# In servers, also start the public message with a mention of the person being answered.
MENTION_AUTHOR_IN_SERVERS=false
